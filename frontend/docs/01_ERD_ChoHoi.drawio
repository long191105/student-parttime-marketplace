low=hidden;fontSize=11;fontColor=#555555;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1700" height="40" as="geometry"/></mxCell><mxCell id="n168" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="280" height="154" as="geometry"/></mxCell><mxCell id="n169" value="Chú giải nhóm bảng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=12;fontColor=#222222;fontStyle=1;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="48" y="122" width="264" height="22" as="geometry"/></mxCell><mxCell id="n170" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="152" width="22" height="16" as="geometry"/></mxCell><mxCell id="n171" value="Người dùng &amp; bảo mật" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=11;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="80" y="148" width="235" height="24" as="geometry"/></mxCell><mxCell id="n172" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="178" width="22" height="16" as="geometry"/></mxCell><mxCell id="n173" value="Danh mục &amp; vị trí" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=11;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="80" y="174" width="235" height="24" as="geometry"/></mxCell><mxCell id="n174" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="204" width="22" height="16" as="geometry"/></mxCell><mxCell id="n175" value="Tin đăng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=11;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="235" height="24" as="geometry"/></mxCell><mxCell id="n176" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="230" width="22" height="16" as="geometry"/></mxCell><mxCell id="n177" value="Tương tác (yêu thích, nhắn tin, đánh giá)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=11;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="80" y="226" width="235" height="24" as="geometry"/></mxCell><mxCell id="n178" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="52" y="256" width="22" height="16" as="geometry"/></mxCell><mxCell id="n179" value="Quản trị &amp; thông báo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=11;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="80" y="252" width="235" height="24" as="geometry"/></mxCell><mxCell id="n180" value="Ràng buộc &amp; chỉ mục chính (xem chi tiết trong tài liệu)&lt;br&gt;• users: UK(email), UK(phone); role ∈ {MEMBER, ADMIN}&lt;br&gt;• listing: CHECK(price ≥ 0); status ∈ {PENDING, ACTIVE, REJECTED, EXPIRED, SOLD, HIDDEN}&lt;br&gt;• listing_attribute_value: UK(listing_id, attribute_id)&lt;br&gt;• category_attribute: UK(category_id, code); data_type ∈ {TEXT, NUMBER, SELECT, BOOLEAN}&lt;br&gt;• conversation: UK(listing_id, buyer_id); CHECK(buyer_id &lt;&gt; seller_id)&lt;br&gt;• review: CHECK(reviewer_id &lt;&gt; reviewee_id) – chống tự đánh giá; UK(reviewer_id, listing_id)&lt;br&gt;• otp_token: hết hạn sau 5 phút; failed_attempts ≤ 5&lt;br&gt;• Index listing: (status, category_id, province_id, bumped_at DESC), price, created_at; GIN pg_trgm(title_normalized)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=10;fontColor=#222222;align=left;verticalAlign=top;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="280" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>