ification (không thêm cột) để tránh nhắc trùng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>