ng JPA Specification (status = ACTIVE)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="824" y="268" width="330" height="30" as="geometry"/></mxCell><mxCell id="n18" value="5. SELECT ... WHERE title_normalized ILIKE ... AND (EXISTS attr_value ...) ORDER BY ... LIMIT/OFFSET" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="326" as="sourcePoint"/><mxPoint x="980" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="6. Page&lt;Listing&gt; + COUNT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="374" as="sourcePoint"/><mxPoint x="770" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="422" as="sourcePoint"/><mxPoint x="770" y="444" as="targetPoint"/><Array as="points"><mxPoint x="820" y="422"/><mxPoint x="820" y="444"/></Array></mxGeometry></mxCell><mxCell id="n21" value="7. Map sang ListingSummary (ảnh thu nhỏ); che SĐT nếu không có JWT hợp lệ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="824" y="412" width="330" height="30" as="geometry"/></mxCell><mxCell id="n22" value="8. 200 {content[], page, size, totalElements, totalPages}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444