</mxCell><mxCell id="n7" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="140" height="44" as="geometry"/></mxCell><mxCell id="n8" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="104" as="sourcePoint"/><mxPoint x="560" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n9" value="Người bán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="140" height="44" as="geometry"/></mxCell><mxCell id="n10" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="104" as="sourcePoint"/><mxPoint x="770" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n11" value="1. Mỗi đêm 02:00: expireListings()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="134" as="sourcePoint"/><mxPoint x="350" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n12" value="2. UPDATE listing SET status = EXPIRED WHERE status = ACTIVE AND expires_at &lt; now()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="182" as="sourcePoint"/><mxPoint x="560" y="182" as="targetPoint"/></mxGeometry>