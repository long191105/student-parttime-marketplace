"1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="134" as="sourcePoint"/><mxPoint x="350" y="134" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n16" value="2. POST /api/auth/register" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="182" as="sourcePoint"/><mxPoint x="560" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n17" value="" style="html=1;endArrow=block;edgeStyle=orthogonalEdgeStyle;strokeColor=#444;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="230" as="sourcePoint"/><mxPoint x="560" y="252" as="targetPoint"/><Array as="points"><mxPoint x="610" y="230"/><mxPoint x="610" y="252"/></Array></mxGeometry></mxCell><mxCell id="n18" value="3. Bean Validation (email, mật khẩu ≥ 8, SĐT)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=10;fontColor=#222222;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="614" y="220" width="330" height="30" as="geometry"/></mxCell><mxCell id="n19" value="4. register(dto)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="278" as="sourcePoint"/><mxPoint x="770" y="278" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n20" value="5. INSERT users (BCrypt, email_verified=false)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="326" as="sourcePoint"/><mxPoint x="980" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n21" value="6. INSERT otp_token (hash, hết hạn 5 phút)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="374" as="sourcePoint"/><mxPoint x="980" y="374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="7. Gửi OTP 6 số qua JavaMailSender" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="422" as="sourcePoint"/><mxPoint x="1190" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="8. 201 {userId, otpExpiresIn: 300}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="470" as="sourcePoint"/><mxPoint x="350" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n24" value="9. Nhập OTP" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="518" as="sourcePoint"/><mxPoint x="350" y="518" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="10. POST /api/auth/verify-otp" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="566" as="sourcePoint"/><mxPoint x="560" y="566" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="11. verifyOtp(userId, code)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="614" as="sourcePoint"/><mxPoint x="770" y="614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="12. SELECT otp_token; sai → failed_attempts+1 (≥5 → khóa 15 phút)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="662" as="sourcePoint"/><mxPoint x="980" y="662" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n28" value="13. UPDATE users.email_verified=true; otp.used=true" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="710" as="sourcePoint"/><mxPoint x="980" y="710" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="14. 200 OK" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="758" as="sourcePoint"/><mxPoint x="350" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n30" value="15. Đăng nhập" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="806" as="sourcePoint"/><mxPoint x="350" y="806" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n31" value="16. POST /api/auth/login" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="854" as="sourcePoint"/><mxPoint x="560" y="854" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n32" value="17. authenticate + tạo JWT (≤ 24 giờ)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=0;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="902" as="sourcePoint"/><mxPoint x="770" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n33" value="18. 200 {token, user{id, fullName, role}}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="950" as="sourcePoint"/><mxPoint x="350" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n34" value="OTP số điện thoại giả lập: ghi log thay vì gửi SMS thật (đã nêu trong kiến trúc buổi 4). FE lưu JWT và gắn Authorization: Bearer cho mọi request sau." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="F3 Đăng tin + duyệt"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1160" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="F3 · Luồng đăng tin, duyệt tin và thông báo (FR-09 → FR-11, FR-29, FR-33)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=17;fontColor=#1f2a5a;fontStyle=1;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Thành viên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6