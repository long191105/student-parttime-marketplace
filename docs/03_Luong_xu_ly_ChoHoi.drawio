<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="d1" name="F1 Vòng đời trạng thái tin"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="F1 · Vòng đời trạng thái của tin đăng (listing.status)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=17;fontColor=#1f2a5a;fontStyle=1;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="n3" value="" style="ellipse;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="24" height="24" as="geometry"/></mxCell><mxCell id="n4" value="PENDING&lt;br&gt;Chờ duyệt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="n5" value="ACTIVE&lt;br&gt;Đang hiển thị" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="n6" value="REJECTED&lt;br&gt;Bị từ chối" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="380" width="170" height="60" as="geometry"/></mxCell><mxCell id="n7" value="EXPIRED&lt;br&gt;Hết hạn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="170" height="60" as="geometry"/></mxCell><mxCell id="n8" value="SOLD&lt;br&gt;Đã bán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=1;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="170" height="60" as="geometry"/></mxCell><mxCell id="n9" value="HIDDEN&lt;br&gt;Đã ẩn / bị gỡ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#555;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=1;strokeWidth=2;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="560" width="170" height="60" as="geometry"/></mxCell><mxCell id="n10" value="POST /api/listings" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="Admin duyệt (approve)&lt;br&gt;expires_at = +30 ngày" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="Admin từ chối (reject + lý do)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="Người bán sửa &amp; gửi lại" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="410"/><mxPoint x="120" y="230"/></Array></mxGeometry></mxCell><mxCell id="n14" value="Scheduler: quá 30 ngày" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value="Gia hạn (renew)&lt;br&gt;expires_at = +30 ngày" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=1;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="300"/><mxPoint x="639" y="300"/></Array></mxGeometry></mxCell><mxCell id="n16" value="Người bán sửa nội dung chính&lt;br&gt;→ duyệt lại" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="571" y="120"/><mxPoint x="265" y="120"/></Array></mxGeometry></mxCell><mxCell id="n17" value="Đánh dấu đã bán" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="Người bán ẩn / Admin gỡ (báo cáo vi phạm)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="228"/><mxPoint x="740" y="590"/></Array></mxGeometry></mxCell><mxCell id="n19" value="Hiện lại (chỉ khi do người bán ẩn)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#444;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="n9" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="590"/><mxPoint x="470" y="228"/></Array></mxGeometry></mxCell><mxCell id="n20" value="Quy tắc: (1) Chỉ tin ACTIVE xuất hiện ở tìm kiếm, trang chủ, hồ sơ người bán. (2) Chủ tin và Admin xem được tin ở mọi trạng thái. (3) Mỗi lần chuyển trạng thái do Admin/Scheduler tạo 1 bản ghi notification cho người bán. (4) Đẩy tin (bump) chỉ áp dụng cho ACTIVE: cập nhật bumped_at, tối đa 1 lần/ngày/tin (ghi vào listing_bump). (5) SOLD và HIDDEN là đề xuất bổ sung, nét đứt – cần đối chiếu SRS v1.0 trước khi chốt." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;fontStyle=0;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1500" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="F2 Đăng ký + OTP"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1208" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="F2 · Luồng đăng ký, xác thực OTP và đăng nhập (FR-02, NFR-02)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=17;fontColor=#1f2a5a;fontStyle=1;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Người dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="60" width="140" height="44" as="geometry"/></mxCell><mxCell id="n4" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="104" as="sourcePoint"/><mxPoint x="140" y="1032" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n5" value="React SPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="140" height="44" as="geometry"/></mxCell><mxCell id="n6" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="104" as="sourcePoint"/><mxPoint x="350" y="1032" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n7" value="Controller + Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8ff;strokeColor=#6c8ebf;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;fontStyle=1;dashed=0;strokeWidth=1;spacingLeft=6;spacingRight=6;arcSize=8;" vertex="1" parent="1"><mxGeometry x="490" y="60" width="140" height="44" as="geometry"/></mxCell><mxCell id="n8" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="104" as="sourcePoint"/><mxPoint x="560" y="1032" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n9" value="Service" styl