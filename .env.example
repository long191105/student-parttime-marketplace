# Shared Neon PostgreSQL database
DB_URL=jdbc:postgresql://ep-solitary-hill-a1iddt17.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_WITH_NEON_PASSWORD
DB_POOL_SIZE=10

# Local application settings
SERVER_PORT=8080
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET_BASE64=false
JWT_EXPIRATION_MS=3600000
ADMIN_EMAIL=admin@chohoi.vn
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Metered TURN static credentials (not required for coturn shared-secret mode)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Metered alias names
# METERED_DOMAIN=cho-hoi.metered.live
# METERED_TURN_USERNAME=
# METERED_TURN_PASSWORD=

# Optional coturn shared-secret mode
# TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600

# Brevo API (use an authorized sender address from your Brevo account)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Cho Hoi
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CLEANUP_INTERVAL_MS=3600000
