# Shared Neon PostgreSQL database
DB_URL=jdbc:postgresql://ep-solitary-hill-a1iddt17.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_WITH_NEON_PASSWORD
DB_POOL_SIZE=10

# Local application settings
SERVER_PORT=8080
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET_BASE64=false
JWT_EXPIRATION_MS=3600000
ADMIN_EMAIL=admin@chohoi.vn
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gmail SMTP (use a Google App Password, not your Gmail login password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_CLEANUP_INTERVAL_MS=3600000
